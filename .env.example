# Copy to .env for local runs. .env is gitignored; never commit real secrets.
# In production these are set as Portainer stack environment variables.

# --- Server (read today by internal/config) ---

# TCP port the server listens on.
PORT=8080

# slog level: debug | info | warn | error
LOG_LEVEL=info

# Public origin of this instance. The OIDC redirect URI and the session
# cookie's Secure flag are both derived from it: an https:// value means Secure
# cookies, http://localhost keeps local development working.
BASE_URL=http://localhost:8080

# Path to the SQLite database file. Its directory is created at startup and
# must be writable by the process uid — in the container that is uid 1000 and
# the ./data volume. The default is relative, which resolves to
# /app/data/robocolony.db in the container (WORKDIR /app) and to ./data locally.
DB_PATH=./data/robocolony.db

# --- Deployment only (docker-compose.yml, not read by the binary) ---

# Public domain Traefik routes to this stack, e.g. robocolony.example.com
HOSTNAME=localhost

# Name of the external Traefik docker network.
TRAEFIK_NETWORK_NAME=traefik_default

# --- Google sign-in (required: the server will not start without these) ---

# OAuth 2.0 Web application client from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Defaults to BASE_URL + /auth/callback, which is the value to
# register as an authorised redirect URI on the OAuth client — it must match
# byte for byte. Set this only if the console entry differs.
# GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Traefik ACME resolver name, and the base domain whose certificate covers
# HOSTNAME (set this when a wildcard certificate is in use).
TRAEFIK_CERT_RESOLVER=myresolver
TRAEFIK_CERT_DOMAIN=
